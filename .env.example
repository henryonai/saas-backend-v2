# Copy to .env for local runs (sam local, scripts). Never commit .env.
# In AWS these come from template.yaml instead.

EVENT_BUS_NAME=default

# accounts
ACCOUNTS_TABLE=saas-dev-AccountsTable-XXXX
USER_POOL_ID=ap-southeast-1_XXXXXXXX

# orders
ORDERS_TABLE=saas-dev-OrdersTable-XXXX

# notifications
NOTIFICATIONS_TABLE=saas-dev-NotificationsTable-XXXX
EMAIL_SENDER=

# billing (locally you may set the secret directly instead of the SSM name)
BILLING_TABLE=saas-dev-BillingTable-XXXX
PAYMENT_WEBHOOK_SECRET=local-dev-secret
APP_URL=http://localhost:5173
