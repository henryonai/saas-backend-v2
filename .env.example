# Copy to .env for local runs (sam local, scripts). Never commit .env.
# In AWS these come from template.yaml instead. Tests ignore this file.

EVENT_BUS_NAME=saas-dev-events
APP_URL=http://localhost:5173          # billing checkout + invitation emails

# accounts
ACCOUNTS_TABLE=saas-dev-AccountsTable-XXXX
USER_POOL_ID=ap-southeast-1_XXXXXXXX
INVITATION_DAYS=7
INVITES_PER_DAY=20
MAX_PENDING_INVITATIONS_PER_EMAIL=5
MAX_WORKSPACES_PER_USER=20             # the login token lists them all

# orders
ORDERS_TABLE=saas-dev-OrdersTable-XXXX

# notifications
NOTIFICATIONS_TABLE=saas-dev-NotificationsTable-XXXX
EMAIL_SENDER=

# billing (locally you may set secrets directly instead of their SSM names)
BILLING_TABLE=saas-dev-BillingTable-XXXX
PAYMENT_PROVIDER=dev                   # or stripe
PAYMENT_WEBHOOK_SECRET=local-dev-secret
STRIPE_SECRET_KEY=                     # sk_test_... (Stripe only)
STRIPE_CONFIG=                         # what scripts/stripe-setup.py saves in SSM (Stripe only)

# assistant (runs on AgentCore Runtime; locally: see modules/assistant/README.md)
ASSISTANT_TABLE=saas-dev-AssistantTable-XXXX
CHECKPOINT_TABLE=saas-dev-AssistantCheckpointTable-XXXX
CHECKPOINT_BUCKET=saas-dev-assistantcheckpointbucket-xxxx
API_URL=https://XXXX.execute-api.ap-southeast-1.amazonaws.com
REGION=ap-southeast-1
MODEL_ID=deepseek/deepseek-v4.1-flash-1017    # OpenRouter (vendor/model); a Bedrock id works too
OPENROUTER_API_KEY=                           # locally; in AWS, OPENROUTER_API_KEY_PARAM names an SSM parameter
SANDBOX_ID=saas_dev_sandbox-XXXXXXXXXX
