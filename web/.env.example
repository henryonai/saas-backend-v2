# Copy to .env.local (gitignored), or write it from the stack's outputs:
#   ./scripts/env-from-stack.sh saas-dev
VITE_API_URL=https://XXXX.execute-api.ap-southeast-1.amazonaws.com
VITE_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional: the assistant's AG-UI endpoint (the AssistantUrl output). Without it the Assistant page says it isn't set up.
VITE_ASSISTANT_URL=https://bedrock-agentcore.ap-southeast-1.amazonaws.com/runtimes/XXXX/invocations?qualifier=DEFAULT&accountId=XXXXXXXXXXXX
